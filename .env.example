# =========================================================================
# Omena Codex — environment template
# Copy to .env. Public (VITE_*) values are bundled into the browser.
# Server-only secrets are read inside server functions / server routes only.
# Never commit a populated .env file.
# =========================================================================

# --- Lovable Cloud / Supabase backend (required) -------------------------
# Public (safe in browser bundle):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Server-only mirrors (do NOT prefix with VITE_):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Service role: bypasses RLS — server-only, never expose to the browser:
SUPABASE_SERVICE_ROLE_KEY=

# --- AI gateway / model providers ----------------------------------------
# Preferred: Lovable AI gateway (provisioned automatically on Lovable Cloud).
LOVABLE_API_KEY=
# Optional direct provider keys — only used as fallback when no provider
# row matches and the user hasn't configured a key in Settings → Providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_MODEL_BASE_URL=
CUSTOM_MODEL_API_KEY=

# --- Server-agent (filesystem / shell daemon) ----------------------------
# Configure per-server via Settings → Servers in the UI. These are
# fallbacks/defaults used by docker-compose and the verification script.
SERVER_AGENT_TOKEN=                  # long random string (>=32 chars)
SERVER_AGENT_WORKSPACE=./workspace   # host path mounted into the daemon
SERVER_AGENT_COMMAND_TIMEOUT_MS=60000
SERVER_AGENT_MAX_FILE_BYTES=1048576
# Legacy single-daemon fallback (only used if no `servers` row matches):
AGENT_DAEMON_URL=
AGENT_DAEMON_TOKEN=

# --- Browser-agent (OPTIONAL — DISABLED unless both are set) -------------
# Leave blank to keep all browser tools hidden from the planner.
BROWSER_AGENT_URL=
BROWSER_AGENT_TOKEN=
BROWSER_AGENT_TIMEOUT_MS=30000
BROWSER_AGENT_ALLOWED_ORIGINS=

# --- Reverse proxy / public hostname (production) ------------------------
DOMAIN=                              # e.g. codex.example.com
APP_PUBLIC_URL=                      # e.g. https://codex.example.com

# --- Webhook signing secret (for /api/public/* callers) ------------------
WEBHOOK_SECRET=

# --- Legacy frontend fallback (only if running against a different API) --
VITE_API_BASE_URL=
VITE_WS_URL=
