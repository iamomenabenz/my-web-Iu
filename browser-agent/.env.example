# Browser-agent daemon configuration (scaffold — disabled by default)
# Copy to `.env` and fill in to enable.

# Port to bind on the host running the daemon.
PORT=8788

# Long random string — must match BROWSER_AGENT_TOKEN on the Omena app side.
DAEMON_TOKEN=

# Optional allow-list of origins the daemon may navigate to. Comma-separated.
# Leave empty in development; set explicit allow-list for production.
ALLOWED_ORIGINS=

# Max bytes returned per /sessions/extract call (default 1 MiB).
MAX_EXTRACT_BYTES=1048576

# Per-request timeout for browser actions in ms.
ACTION_TIMEOUT_MS=20000
